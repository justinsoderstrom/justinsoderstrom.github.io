---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import TagList from '../../components/TagList.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PostNav from '../../components/PostNav.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are sorted newest first, so the newer post sits one index back.
      prevPost: posts[index + 1],
      nextPost: posts[index - 1],
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, draft, comments, tags } =
  post.data;

// JPEG for the OG card — LinkedIn's scraper doesn't reliably handle WebP.
const ogImage = heroImage
  ? new URL(
      (await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src,
      Astro.site,
    )
  : undefined;

const canonical = new URL(`/blog/${post.id}/`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogImage && { image: ogImage.href }),
  mainEntityOfPage: canonical.href,
  author: {
    '@type': 'Person',
    name: 'Justin Soderstrom',
    url: 'https://justinsoderstrom.com',
  },
};
---

<BaseLayout
  title={`Justin Soderstrom: ${title}`}
  description={description}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="prose">
    {
      heroImage && (
        <Image src={heroImage} alt="" widths={[720, 1440]} class="hero-image" />
      )
    }
    <header>
      <h1>
        {title}
        {draft && <span class="draft-badge">draft</span>}
      </h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              {' · updated '}
              <time datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate)}
              </time>
            </>
          )
        }
      </p>
      <TagList tags={tags} />
      <ShareButtons url={canonical} title={title} />
    </header>
    <Content />
    <ShareButtons url={canonical} title={title} />
  </article>
  <PostNav prevPost={prevPost} nextPost={nextPost} />
  {comments && <Comments />}
</BaseLayout>
