---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getPublishedPosts, getAllTags, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();
const tags = await getAllTags();
---

<BaseLayout
  title="Justin Soderstrom: Blog"
  description="Writing on .NET, Azure, and software development by Justin Soderstrom."
>
  <h1>Blog</h1>

  {
    tags.length > 0 && (
      <ul class="tag-list tag-list-lg">
        {tags.map(({ slug, tag, count }) => (
          <li>
            <a href={`/blog/tags/${slug}/`}>
              {tag} <span class="tag-count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts.length === 0 ? (
      <div class="empty-state">
        <p>Nothing here yet — the first post is still brewing.</p>
        <p>
          In the meantime, check out my <a href="/projects/">projects</a>.
        </p>
      </div>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="draft-badge">draft</span>}
            </h2>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <p>{post.data.description}</p>
            <TagList tags={post.data.tags} />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
