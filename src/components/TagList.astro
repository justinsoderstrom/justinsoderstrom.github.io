---
import { tagSlug } from '../lib/blog';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
        </li>
      ))}
    </ul>
  )
}
